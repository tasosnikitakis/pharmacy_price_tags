# Copy to .env, then append generated secrets:
#   python -m core.gen_secrets >> .env
# Never commit .env. Every secret below is required; the app refuses to start without it.

# Docker Compose (core + Postgres). Required; appended by core.gen_secrets:
# POSTGRES_PASSWORD=...
# SESSION_SECRET=...
# GATEWAY_TOKEN=...
CORE_PORT=8000

# Running core outside Compose (development): your own Postgres, password included.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<db>

# Gateway (runs natively on the shop box)
# CORE_URL=https://esl.local
# GATEWAY_DRIVER=fake

STALE_IMPORT_DAYS=7
