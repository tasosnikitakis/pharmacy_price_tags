# Copy to .env, then append generated secrets:
#   python -m core.gen_secrets >> .env
# Never commit .env. Every secret below is required; the app refuses to start without it.

# Docker Compose (core + Postgres). Required; appended by core.gen_secrets:
# POSTGRES_PASSWORD=...
# SESSION_SECRET=...
# GATEWAY_TOKEN=...
CORE_PORT=8000

# Running core outside Compose (development): your own Postgres, password included.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<db>

# Gateway (runs natively on the shop box)
# CORE_URL=https://esl.local
# GATEWAY_DRIVER=fake

STALE_IMPORT_DAYS=7

# Import preview: warn when a price changes by more than this percent, and ask for an
# extra confirmation when more than PRICE_JUMP_BANNER_PERCENT of the price changes warn.
# PRICE_JUMP_WARN_PERCENT=50
# PRICE_JUMP_BANNER_PERCENT=20

# Login throttling (decision 0019): after ACCOUNT_FREE failed logins for one email, or
# IP_FREE from one address (which must be larger), each further failure waits BASE
# seconds, then doubles, at most MAX.
# Failures are forgotten after WINDOW seconds without one. No permanent lockout.
# LOGIN_THROTTLE_ACCOUNT_FREE=5
# LOGIN_THROTTLE_IP_FREE=20
# LOGIN_THROTTLE_BASE_SECONDS=2
# LOGIN_THROTTLE_MAX_SECONDS=900
# LOGIN_THROTTLE_WINDOW_SECONDS=3600
